          "description": "How this item or scale is scored, including any summing, averaging, or weighting rules (e.g. sum score, factor scores, weighted sum scores).",
          "type": "string"
        },
        "Reverse.Coded": {
          "description": "Whether this item is reverse coded or otherwise transformed before use.",
          "type": "boolean"
        },
        "Transformation": {
          "description": "Description of any transformation applied to this item beyond simple reverse coding. This could also include transformation needed for this item (ie. log-transform reaction time).",
          "type": "string"
        },
