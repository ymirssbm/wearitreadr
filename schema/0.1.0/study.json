{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ymirssbm/wearitreadr/schema/0.1.0/study.json",
  "title": "Wear-IT Study Specification",
  "version": "0.1.0",
  "description": "This specification contains all the needed information to both run a study using the Wear-IT framework. This includes all the needed information to make reproducible and replicable codebooks for complex designs.",
  "type": "object",
  "examples": [
    {
      "Study.Name": "Recovery Community Center Project",
      "authors": "Jane Smith, John Doe, Emily R. Johnson",
      "funding": "NIH Grant R01DA012345; NSF Award 9876543",
      "abstract": "This study examined daily stress and recovery patterns among adults attending a recovery community center. Participants completed ecological momentary assessments four times daily over 14 days across two bursts.",
      "studyID": 1045
    }
  ],
  "properties": {
    "Study.Name": {
      "description": "Human readable long name for a study",
      "type": "string"
    },
    "authors": {
      "description": "String of all people to be credited for this study. This will appear in the authors section of a generated codebook.",
      "type": "string"
    },
    "funding": {
      "description": "String containing relevant funding info for the study",
      "type": "string"
    },
    "abstract": {
      "description": "String containing qualitative description of the study. This could include main study objectives, relevant findings, study population etc.",
      "type": "string"
    },
    "burst": {
      "$anchor": "burst",
      "title": "Burst Specification",
      "description": "Contains all the information to specify burst design",
      "type": "object",
      "examples": [
        {
          "burstID": 1,
          "survey": {
            "Survey.LongName": "Morning Daily Diary",
            "Survey.ShortName": "MDD",
            "Survey.Timing": 4,
            "surveyID": 6205
          }
        }
      ],
      "properties": {
        "burstID": {
          "description": "Burst numeric identifier",
          "type": "integer"
        },
        "survey": {
          "$anchor": "survey",
          "title": "Survey Specification",
          "description": "Contains all the information needed to specify survey design",
          "type": "object",
          "examples": [
            {
              "Survey.LongName": "Morning Daily Diary",
              "Survey.ShortName": "MDD",
              "Survey.Timing": 4,
              "surveyID": 6205
            }
          ],
          "properties": {
            "Survey.LongName": {
              "description": "Human readable survey long name",
              "type": "string"
            },
            "Survey.ShortName": {
              "description": "Human readable survey short name",
              "type": "string"
            },
            "Survey.Timing": {
              "description": "Timing of the survey (once a day, every hour, upon triggering...).",
              "type": "integer"
            },
            "block": {
              "$ref": "#block"
            },
            "question": {
              "$anchor": "question",
              "title": "Question Specification",
              "description": "Contains all the information needed to specify a question or variable in a survey, observation, or passive data collection context.",
              "type": "object",
              "examples": [
                {
                  "Question.ID": "stress_q1",
                  "Question.Long.Name": "Perceived Stress Item 1",
                  "Question.Text": "How stressed have you felt in the past hour?",
                  "Question.Description": "A self-report measure of perceived stress on a scale from 0 (not at all) to 100 (extremely).",
                  "Question.Type.Display.Name": "digital slider",
                  "Unique.Timing": "Delivered once per day at 9:00 AM regardless of survey schedule",
                  "Parent": "block_001",
                  "Conditional.Child.Item.ID": "question_stress_followup",
                  "Conditional.Fail.Item.ID": "question_skip_to_mood",
                  "Conditional.Master.Item.ID": "question_stress_q1",
                  "Conditional.Threshold": "50",
                  "Conditional.Type": "2",
                  "Data.Type": "continuous",
                  "Measurement.Interval": "4 hours",
                  "Item.ID": "item_pss_01"
                }
              ],
              "properties": {
                "Question.ID": {
                  "description": "Name of the variable as it appears in the dataset",
                  "type": "string"
                },
                "Question.Long.Name": {
                  "description": "Human readable name for the variable",
                  "type": "string"
                },
                "Question.Text": {
                  "description": "Exact text of the question as presented to the participant. Only applicable for survey questions.",
                  "type": "string"
                },
                "Question.Description": {
                  "description": "Description of the variable in layman's terms. If layman's terms are not possible, provide a citation to a longer explanation.",
                  "type": "string"
                },
                "Question.Type.Display.Name": {
                  "description": "How the data was obtained (e.g. sensing, survey, observation, circling on page, digital slider).",
                  "type": "string"
                },
                "Unique.Timing": {
                  "description": "Description of question timing if it is not shared with the survey.",
                  "type": "string"
                },
                "Parent": {
                  "description": "Item ID of the parent item. NOTE: This is different then the conditional master which points to the item which if successful, delivers the current. Parent may point to a block many questions up",
                  "type": "string"
                },
                "Conditional.Child.Item.ID": {
                  "description": "Contains the Item ID for the successful child of the current question. If the current question is successful, deliver the child item.",
                  "type": "string"
                },
                "Conditional.Fail.Item.ID": {
                  "description": "Contains the Item ID for the fail child of the current question. If the current question is failed, deliver the fail item.",
                  "type": "string"
                },
                "Conditional.Master.Item.ID": {
                  "description": "Contains the Item ID for the parent of the current question if the current question is a conditional child or fail.",
                  "type": "string"
                },
                "Conditional.Threshold": {
                  "description": "threshold is the preset value being compared to the user response. The value can be either a true value (the user slid the slider and it stopped on 51) or it might point to a response relative to the order of responses (i.e. There is a multiple choice question, it has 5 responses, they chose response #3, it can be any value)",
                  "type": "string"
                },
                "Conditional.Type": {
                  "description": "conditional type is the comparator. It can take on a value from 1-6 which corresponds with... (in order: =, <=, >=, <, >, !=)",
                  "type": "string"
                },
                "Data.Type": {
                  "description": "The type of data captured by this variable. Oldname: Result.Type",
                  "type": "string",
                  "enum": ["numeric", "categorical", "continuous", "ordinal", "binary", "text", "other"]
                },
                "Measurement.Interval": {
                  "description": "Distance or frequency between measurements (e.g. 1 day, 1 hour).",
                  "type": "string"
                },
                "Item.ID": {
                  "description": "Item ID for this question",
                  "type": "string"
                }
              },
              "required": [
                "Question.ID",
                "Question.Long.Name",
                "Question.Text",
                "Question.Description",
                "Question.Type.Display.Name",
                "Unique.Timing",
                "Parent",
                "Conditional.Child.Item.ID",
                "Conditional.Fail.Item.ID",
                "Conditional.Master.Item.ID",
                "Conditional.Threshold",
                "Conditional.Type",
                "Data.Type",
                "Measurement.Interval",
                "Item.ID"
              ]
            }
          },
          "required": [
            "Survey.LongName",
            "Survey.ShortName",
            "Survey.Timing",
            "block",
            "question"
          ]
        }
      },
      "required": ["burstID", "survey"]
    },
    "data": {
      "$anchor": "data",
      "$ref": "https://github.com/ymirssbm/wearitreadr/schema/0.1.0/data.json"
    },
    "responseKey": {
      "$anchor": "responseKey",
      "title": "Response Key Specification",
      "description": "Contains all the information needed to map response values to their definitions for a given survey question.",
      "type": "object",
      "examples": [
        {
          "survey": "MDD",
          "question": "stress_q1",
          "type": "Likert",
          "value": "3",
          "definition": "Fairly Often"
        }
      ],
      "properties": {
        "survey": {
          "description": "Short name of the survey this response key belongs to.",
          "type": "string"
        },
        "question": {
          "description": "Question ID this response key belongs to.",
          "type": "string"
        },
        "type": {
          "description": "The type of response scale used (e.g. Likert, VAS, binary, forced choice).",
          "type": "string"
        },
        "value": {
          "description": "The numeric or coded value of the response as it appears in the dataset.",
          "type": "string"
        },
        "definition": {
          "description": "The human readable label or meaning corresponding to the response value.",
          "type": "string"
        }
      },
      "required": [
        "survey",
        "question",
        "type",
        "value",
        "definition"
      ]
    },
    "itemMap": {
      "title": "Item Map Repo",
      "description": "This specification contains all the needed information to describe a single item or scale used within the Wear-IT framework, including its conceptual, psychometric, and delivery properties.",
      "type": "object",
      "examples": [
        {
          "Item.Text": "How stressed did you feel today?",
          "Conceptualization": "Perceived psychological stress",
          "Modeling.Characteristics": "Typically used as an outcome variable; no transformation required",
          "Validated": true,
          "Scale.Name": "Perceived Stress Scale",
          "Parent.Scale": "Perceived Stress Scale",
          "Sub.Scale": "Perceived Helplessness",
          "scaleOrItem": "item",
          "Scale.Type": "Likert",
          "Scoring": "sum score",
          "Reverse.Coded": false,
          "Transformation": "None",
          "Identifying.Info": false,
          "Data.Type": "ordinal",
          "Time.Stem": "in the last month",
          "Top.Level.Question": "Indicate to what extent you...",
          "Values": "0-4",
          "Definition": "Never, Almost Never, Sometimes, Fairly Often, Very Often",
          "Delivery.Mechanism": "mobile app",
          "Delivery.Frequency": "once daily",
          "Article.Title": "A global measure of perceived stress",
          "Citation": "Cohen, S., Kamarck, T., & Mermelstein, R. (1983). https://doi.org/10.2307/2136404",
          "notes": "Standard PSS-10 item; time stem adapted from original"
        }
      ],
      "properties": {
        "Item.Text": {
          "description": "Exact text of the item as presented.",
          "type": "string"
        },
        "Conceptualization": {
          "description": "What construct or concept does this item measure or represent?",
          "type": "string"
        },
        "Modeling.Characteristics": {
          "description": "Usual modeling characteristics or how this item is typically used in analysis (e.g. predictor, outcome, mediator, covariate). For example, reaction time is often log transformed.",
          "type": "string"
        },
        "Validated": {
          "description": "Whether this item is part of a statistically validated measure.",
          "type": "boolean"
        },
        "Scale.Name": {
          "description": "Name of the scale this item belongs to.",
          "type": "string"
        },
        "Parent.Scale": {
          "description": "Name of the parent scale if this item belongs to a subscale.",
          "type": "string"
        },
        "Sub.Scale": {
          "description": "Name of the subscale this item belongs to, if applicable.",
          "type": "string"
        },
