          "description": "Whether this item potentially contains personally identifying information.",
          "type": "boolean"
        },
        "Data.Type": {
          "description": "Type of data this item produces.",
          "type": "string",
          "enum": ["numeric", "categorical", "continuous", "ordinal", "binary", "text", "other"]
        },
        "Time.Stem": {
          "description": "The time reference embedded in the item (e.g. 'in the past week', 'right now', 'today'). This should be the time stem in the cited paper, but can be swapped out to any timestem.",
