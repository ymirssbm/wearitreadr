{
  "$schema": "https://github.com/ymirssbm/wearitreadr/schema/0.1.0",
  "$id": "https://github.com/ymirssbm/wearitreadr/schema/0.1.0/survey.json",
  "title": "Survey Specification",
  "description": "Contains all the information needed to specify survey design",
  "type": "object",
  "examples": [
    {
      "surveyLongName": "Daily Diary",
      "surveyID": "6205"
    }
  ],
  "properties": {
    "surveyLongName": {
      "description": "Human readable survey long name",
      "type": "string"
    },
    "surveyShortName": {
      "description": "Human readable survey short name",
      "type": "string"
    },
    "surveyID": {
      "description": "Survey numeric identifier",
      "type": "integer"
    },
    "block": {
      "$ref":
    },
    "item": {
      "$ref":
    },
    "question": {
      "$ref":
    }
  },
  "required": ["surveyLongName", "surveyID"]
}